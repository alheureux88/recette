# Dropbox — create an app at https://www.dropbox.com/developers/apps
# Use "Scoped access" → "Full Dropbox", grant files.content.read + files.metadata.read
#
# For long-running deployments (recommended), use OAuth2 refresh tokens:
# 1. Go to https://www.dropbox.com/oauth2/authorize?client_id=YOUR_APP_KEY&response_type=code&token_access_type=offline
# 2. Authorize the app and copy the authorization code
# 3. Exchange the code for tokens:
#    curl -X POST https://api.dropbox.com/oauth2/token \
#      -d "code=YOUR_CODE&grant_type=authorization_code&client_id=YOUR_APP_KEY&client_secret=YOUR_APP_SECRET"
# 4. Copy the refresh_token from the response
DROPBOX_REFRESH_TOKEN=your_refresh_token_here
DROPBOX_APP_KEY=your_app_key_here
DROPBOX_APP_SECRET=your_app_secret_here

# Alternative: static token (expires after ~4 hours, not recommended for production)
# DROPBOX_TOKEN=your_dropbox_access_token_here

DROPBOX_FOLDER=/Recipes   # or "" for root of app folder

# Optional: filter files to process (supports * wildcard)
# Examples: "BOEUF*" (only beef recipes), "*.odt" (only ODT files), "DESSERT*" (only desserts)
# Leave empty or omit to process all files
# DROPBOX_FILE_FILTER=

# LLM provider: "openai" (default) or "anthropic"
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1    # only for OpenAI-compatible endpoints
LLM_MODEL=gpt-4o-mini                     # or claude-3-5-sonnet-20241022 for Anthropic

# Poller interval (minutes). Default: 15
POLL_INTERVAL_MINUTES=15

# SQLite path inside the container. Default: /data/recipes.db (the volume)
# DB_PATH=/data/recipes.db
