# Dropbox — create an app at https://www.dropbox.com/developers/apps
# Use "Scoped access" → "Full Dropbox", grant files.content.read + files.metadata.read
DROPBOX_TOKEN=your_dropbox_access_token_here
DROPBOX_FOLDER=/Recipes   # or "" for root of app folder

# LLM provider: "openai" (default) or "anthropic"
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1    # only for OpenAI-compatible endpoints
LLM_MODEL=gpt-4o-mini                     # or claude-3-5-sonnet-20241022 for Anthropic

# Poller interval (minutes). Default: 15
POLL_INTERVAL_MINUTES=15

# SQLite path inside the container. Default: /data/recipes.db (the volume)
# DB_PATH=/data/recipes.db
